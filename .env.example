# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo a .env.local y rellena los valores. NUNCA lo commitees.
#
# Regla de oro: solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador.
# Cualquier otra variable de este archivo es un secreto de servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública. Se prefiere la "publishable" (sb_publishable_...); las claves
# `anon` legacy siguen funcionando. Rellena una de las dos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETO. Ignora la RLS por completo: solo se usa en el webhook de Vapi, que no
# tiene cookie de sesión y por tanto no puede apoyarse en las políticas.
SUPABASE_SERVICE_ROLE_KEY=

# ── Vapi ────────────────────────────────────────────────────────────────────
# SECRETO. Dashboard de Vapi → Organization → API Keys (clave privada/servidor).
VAPI_API_KEY=
# SECRETO. Cadena aleatoria que tú inventas (p. ej. `openssl rand -hex 32`).
# La app la publica en el asistente como cabecera `x-vapi-secret` y la exige en
# cada webhook entrante. Si la rotas aquí, hay que republicar el agente.
VAPI_WEBHOOK_SECRET=

# Valores por defecto del agente. Cada clínica puede sobrescribirlos en el panel.
VAPI_DEFAULT_MODEL=gpt-4o
VAPI_DEFAULT_MODEL_PROVIDER=openai
VAPI_DEFAULT_VOICE_PROVIDER=azure
VAPI_DEFAULT_VOICE_ID=es-MX-DaliaNeural
VAPI_DEFAULT_TRANSCRIBER=deepgram
# Voz de respaldo si Vapi rechaza la voz configurada con un 400.
VAPI_FALLBACK_VOICE_PROVIDER=vapi
VAPI_FALLBACK_VOICE_ID=Elliot

# ── Google Calendar (OAuth 2.0) ─────────────────────────────────────────────
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth
# (tipo "Aplicación web"). Habilita antes la Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con el URI de redirección autorizado en Google.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# ── Aplicación ──────────────────────────────────────────────────────────────
# URL pública de la app. En desarrollo con Vapi debe ser la URL del túnel
# (ngrok), no localhost, o Vapi no podrá alcanzar el webhook.
APP_URL=http://localhost:3000

# SECRETO. Clave de 32 bytes en hex (64 caracteres) para cifrar los tokens de
# Google en la base de datos con AES-256-GCM:  openssl rand -hex 32
ENCRYPTION_KEY=
